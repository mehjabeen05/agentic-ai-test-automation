# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- LLM provider settings ---
# Any OpenAI-compatible API (OpenAI, Azure OpenAI, local proxies, etc.)
# Never put a real key here — this file is committed to version control.
# The API returns a clear error on any endpoint that needs the LLM until a
# real key is set in your local, gitignored .env file.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# --- Application settings ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Storage paths (relative to project root) ---
DATABASE_URL=sqlite:///./data/test_automation.db
GENERATED_TESTS_DIR=tests/generated
SCREENSHOTS_DIR=screenshots
REPORTS_DIR=reports
LOGS_DIR=logs

# --- Safety settings ---
# Generated Playwright tests are only ever allowed to be written inside this directory.
ALLOWED_WORKSPACE_DIR=tests/generated

# --- API settings ---
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated allowed origins for CORS, e.g. http://127.0.0.1:8000
# The bundled dashboard is served from the same origin as the API, so this
# is not needed for local use. Leave empty (the default) to disable CORS
# entirely; only set it if a separate frontend origin calls this API
# directly. Never use * here.
CORS_ORIGINS=
